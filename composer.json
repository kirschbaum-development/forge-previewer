{
    "name": "ryangjchandler/forge-previewer",
    "description": "Create preview deployments for pull request with Laravel Forge.",
    "keywords": ["forge", "laravel", "preview-deploy"],
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ryangjchandler/forge-previewer/issues",
        "source": "https://github.com/ryangjchandler/forge-previewer"
    },
    "authors": [
        {
            "name": "Ryan Chandler",
            "email": "support@ryangjchandler.co.uk"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel-zero/framework": "^12.1",
        "laravel/forge-sdk": "^4.1",
        "nunomaduro/termwind": "^2.4"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["builds/forge-previewer"]
}
